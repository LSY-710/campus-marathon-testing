page {
  color: #17231e;
  background: #f4f0e8;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-heading .title {
  font-size: 34rpx;
  font-weight: 700;
}

.section-heading .more {
  color: #34715f;
  font-size: 24rpx;
}

.event-card {
  overflow: hidden;
  margin-bottom: 22rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(25, 53, 42, 0.07);
}

.event-cover {
  position: relative;
  height: 250rpx;
  background:
    radial-gradient(circle at 76% 26%, rgba(255, 255, 255, 0.36), transparent 23%),
    linear-gradient(145deg, #143e32, #2d846a);
}

.event-cover::after {
  position: absolute;
  right: -48rpx;
  bottom: -92rpx;
  width: 260rpx;
  height: 260rpx;
  content: "";
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;
}

.event-cover-label {
  position: absolute;
  left: 26rpx;
  bottom: 22rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 23rpx;
  letter-spacing: 3rpx;
}

.event-body {
  padding: 25rpx;
}

.event-title {
  margin: 12rpx 0 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.event-meta {
  display: flex;
  justify-content: space-between;
  color: #6b7771;
  font-size: 23rpx;
  line-height: 1.7;
}

.event-price {
  color: #b36b1c;
  font-weight: 700;
}

.status-pill {
  display: inline-flex;
  border-radius: 999rpx;
  padding: 7rpx 16rpx;
  color: #50605a;
  background: #edf1ef;
  font-size: 21rpx;
  font-weight: 600;
}

.status-registering {
  color: #16654e;
  background: #dff4ea;
}

.status-upcoming {
  color: #6d7370;
  background: #ecefed;
}

.status-ended {
  color: #8b5454;
  background: #f6e8e8;
}

.empty-panel {
  padding: 90rpx 30rpx;
  color: #7c8983;
  text-align: center;
  background: white;
  border-radius: 24rpx;
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.primary-button {
  color: white;
  background: #17654f;
}

.secondary-button {
  color: #17654f;
  background: #e2f1eb;
}

.danger-button {
  color: #a14a4a;
  background: #f7eaea;
}

.light-text {
  color: #7a8781;
}

/* Editorial race-club visual system */
.ui-page {
  min-height: 100vh;
  padding: 30rpx 28rpx 48rpx;
  box-sizing: border-box;
  color: #14221c;
  background:
    radial-gradient(circle at 100% 0, rgba(237, 190, 151, 0.22), transparent 28%),
    #f4f0e8;
}

.ui-kicker {
  color: #e55335;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.ui-section-title {
  margin: 0;
  color: #14221c;
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
  line-height: 1.18;
}

.ui-section-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: 48rpx 2rpx 22rpx;
}

.ui-text-link {
  color: #5f685f;
  font-size: 22rpx;
  font-weight: 600;
}

.ui-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 84rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 2rpx solid #14221c;
  border-radius: 999rpx;
  background: #fbf8f1;
}

.ui-search-icon {
  width: 34rpx;
  height: 34rpx;
  position: relative;
  flex: 0 0 34rpx;
  border: 3rpx solid #14221c;
  border-radius: 50%;
  box-sizing: border-box;
}

.ui-search-icon::after {
  position: absolute;
  right: -9rpx;
  bottom: -6rpx;
  width: 14rpx;
  height: 3rpx;
  content: "";
  background: #14221c;
  transform: rotate(45deg);
}

.ui-search-placeholder {
  color: #7b8079;
  font-size: 24rpx;
}

.ui-pill {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 7rpx 15rpx;
  color: #14221c;
  background: #e8e3da;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.ui-pill-registering {
  color: #14221c;
  background: #d9ed72;
}

.ui-pill-upcoming {
  color: #665f56;
  background: #e7e1d6;
}

.ui-pill-ended {
  color: #9d4f43;
  background: #f3d9d2;
}

.ui-empty {
  margin-top: 22rpx;
  padding: 84rpx 26rpx;
  border: 2rpx dashed #c9c1b5;
  border-radius: 28rpx;
  color: #7d817b;
  text-align: center;
  font-size: 24rpx;
}

.ui-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin: 0;
  border-radius: 18rpx;
  color: #fdfbf5;
  background: #14221c;
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.ui-primary[disabled] {
  color: #817f78;
  background: #ddd7cc;
}

.ui-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  margin: 0;
  border: 2rpx solid #14221c;
  border-radius: 18rpx;
  color: #14221c;
  background: transparent;
  font-size: 24rpx;
  font-weight: 750;
}
