.profile-page {
  padding-top: 24rpx;
}

.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  min-height: 900rpx;
  padding: 108rpx 32rpx 40rpx;
  box-sizing: border-box;
  text-align: center;
  background:
    linear-gradient(90deg, rgba(20, 34, 28, 0.05) 1rpx, transparent 1rpx),
    linear-gradient(rgba(20, 34, 28, 0.05) 1rpx, transparent 1rpx),
    #fbf8f1;
  background-size: 70rpx 70rpx;
  border: 2rpx solid #14221c;
  border-radius: 30rpx;
}

.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: #14221c;
  background: #d9ed72;
  font-size: 42rpx;
  font-weight: 900;
}

.prompt-title {
  margin-top: 22rpx;
  color: #14221c;
  font-size: 54rpx;
  font-weight: 900;
  letter-spacing: -3rpx;
  line-height: 1.15;
}

.profile-prompt-copy {
  max-width: 480rpx;
  color: #6c726b;
  font-size: 24rpx;
  line-height: 1.7;
}

.profile-demo {
  margin-top: 6rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: #e55335;
  background: #f5e1da;
  font-family: monospace;
  font-size: 20rpx;
}

.profile-login {
  width: 380rpx;
  margin-top: 18rpx;
}

.runner-poster {
  position: relative;
  overflow: hidden;
  min-height: 410rpx;
  padding: 27rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  color: #fbf8f1;
  background: #14221c;
}

.runner-grid {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  bottom: -80rpx;
  left: -80rpx;
  opacity: 0.11;
  background:
    linear-gradient(90deg, transparent 49%, #fff 50%, transparent 51%),
    linear-gradient(transparent 49%, #fff 50%, transparent 51%);
  background-size: 68rpx 68rpx;
  transform: rotate(-10deg);
}

.runner-top {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  color: #d9ed72;
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.runner-main {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 23rpx;
  margin-top: 46rpx;
}

.runner-copy {
  flex: 1;
  min-width: 0;
}

.runner-label {
  margin-bottom: 10rpx;
  color: #e55335;
  font-size: 14rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.profile-name {
  overflow: hidden;
  color: #fbf8f1;
  font-size: 43rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.runner-handle {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 20rpx;
}

.logout-link {
  position: absolute;
  z-index: 3;
  right: 24rpx;
  top: 60rpx;
  margin: 0;
  color: rgba(255, 255, 255, 0.7);
  background: transparent;
  font-size: 18rpx;
}

.runner-stats {
  position: absolute;
  right: 27rpx;
  bottom: 25rpx;
  left: 27rpx;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding-top: 21rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.runner-stats view {
  padding-right: 10rpx;
  border-right: 1rpx solid rgba(255, 255, 255, 0.16);
}

.runner-stats view:last-child {
  border-right: 0;
}

.runner-stat-number,
.runner-stats text {
  display: block;
}

.runner-stat-number {
  color: #fbf8f1;
  font-size: 34rpx;
  font-weight: 900;
}

.runner-stats text {
  margin-top: 6rpx;
  color: #93a097;
  font-size: 12rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.profile-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 44rpx 3rpx 18rpx;
}

.profile-section-title {
  margin-top: 9rpx;
  color: #14221c;
  font-size: 38rpx;
  font-weight: 900;
}

.profile-count {
  color: #e55335;
  font-size: 43rpx;
  font-weight: 900;
}

.tab-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: 0 0 20rpx;
  border-bottom: 1rpx solid #d7d0c4;
}

.tab-item {
  position: relative;
  padding: 20rpx 6rpx;
  color: #7c817b;
  text-align: center;
  font-size: 23rpx;
  font-weight: 650;
}

.tab-item.is-active {
  color: #14221c;
  font-weight: 900;
}

.tab-item.is-active::after {
  position: absolute;
  right: 34%;
  bottom: -1rpx;
  left: 34%;
  height: 4rpx;
  content: "";
  border-radius: 99rpx;
  background: #e55335;
}

.ticket-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 13rpx;
  padding: 19rpx 20rpx 19rpx 0;
  border: 2rpx solid #14221c;
  border-radius: 21rpx;
  background: #fbf8f1;
}

.ticket-stripe {
  width: 8rpx;
  align-self: stretch;
  margin-right: 1rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: #e55335;
}

.ticket-main {
  flex: 1;
  min-width: 0;
}

.registration-title {
  overflow: hidden;
  margin: 13rpx 0 8rpx;
  color: #14221c;
  font-size: 26rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ticket-meta {
  color: #7c817b;
  font-size: 18rpx;
}

.ticket-arrow {
  color: #e55335;
  font-size: 31rpx;
  font-weight: 800;
}

.feature-list {
  overflow: hidden;
  margin-top: 34rpx;
  border-top: 3rpx solid #14221c;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid #d8d1c5;
}

.feature-index {
  width: 48rpx;
  color: #e55335;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.feature-copy {
  flex: 1;
}

.feature-title,
.feature-copy text {
  display: block;
}

.feature-title {
  margin-bottom: 6rpx;
  color: #14221c;
  font-size: 25rpx;
}

.feature-copy text {
  color: #848780;
  font-size: 19rpx;
}

.feature-count {
  color: #5f665f;
  font-size: 19rpx;
  font-weight: 700;
}
