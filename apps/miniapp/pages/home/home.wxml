<view class="ui-page home-page">
  <view class="masthead">
    <view>
      <text class="ui-kicker">CAMPUS RUN CLUB</text>
      <view class="masthead-meta">校园赛事 · 城市节奏</view>
    </view>
    <view class="profile-entry" bindtap="openProfile">
      <text>ME</text>
    </view>
  </view>

  <view class="home-title">
    <view>RUN</view>
    <view>THE CAMPUS<text class="title-dot">.</text></view>
  </view>

  <view class="ui-search home-search" bindtap="openSearch">
    <view class="ui-search-icon"></view>
    <text class="ui-search-placeholder">搜索马拉松、校园活动</text>
    <text class="search-arrow">↗</text>
  </view>

  <view class="race-poster">
    <view class="poster-grid"></view>
    <view class="poster-top">
      <text>SEASON 02 / 2026</text>
      <text>{{liveCount}} LIVE</text>
    </view>
    <view class="poster-number">42.195</view>
    <view class="poster-copy">
      <text class="poster-label">FEATURED DISTANCE</text>
      <view class="poster-title">向前，是唯一的方向。</view>
    </view>
    <view class="poster-route">
      <view class="route-dot"></view>
    </view>
    <view class="poster-footer">
      <text>CAMPUS · CITY · RUN</text>
      <text class="poster-arrow">↗</text>
    </view>
  </view>

  <view class="ui-section-row">
    <view>
      <text class="ui-kicker">RACE CALENDAR</text>
      <view class="ui-section-title">下一场比赛</view>
    </view>
    <text class="ui-text-link" bindtap="openAll">全部赛事 →</text>
  </view>

  <view wx:if="{{loading}}" class="ui-empty">正在整理赛事信息...</view>
  <view wx:elif="{{!events.length}}" class="ui-empty">暂时没有可报名赛事</view>
  <block wx:else>
    <view
      wx:for="{{events}}"
      wx:key="id"
      class="race-card"
      data-id="{{item.id}}"
      bindtap="openEvent"
    >
      <view class="race-date">
        <text class="race-month">{{item.monthText}}</text>
        <text class="race-day">{{item.dayText}}</text>
        <text class="race-order">NO.{{item.order}}</text>
      </view>
      <view class="race-divider"></view>
      <view class="race-main">
        <view class="race-head">
          <text class="ui-pill {{item.statusClass}}">{{item.statusLabel}}</text>
          <text class="race-price">{{item.priceText}}</text>
        </view>
        <view class="race-name">{{item.title}}</view>
        <view class="race-place">{{item.location}}</view>
        <view class="race-foot">
          <text>{{item.dateText}}</text>
          <text>查看详情 ↗</text>
        </view>
      </view>
    </view>
  </block>
</view>
