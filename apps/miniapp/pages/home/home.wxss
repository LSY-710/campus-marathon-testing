.home-page {
  padding-top: 24rpx;
}

.masthead {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.masthead-meta {
  margin-top: 9rpx;
  color: #72776f;
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.profile-entry {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #14221c;
  border-radius: 50%;
  color: #14221c;
  background: #d9ed72;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.home-title {
  margin: 32rpx 0 28rpx;
  color: #14221c;
  font-size: 74rpx;
  font-weight: 900;
  letter-spacing: -5rpx;
  line-height: 0.94;
}

.title-dot {
  color: #e55335;
}

.home-search {
  margin-bottom: 24rpx;
}

.search-arrow {
  margin-left: auto;
  color: #14221c;
  font-size: 28rpx;
  font-weight: 800;
}

.race-poster {
  position: relative;
  overflow: hidden;
  height: 432rpx;
  padding: 26rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  color: #f9f5e9;
  background: #14221c;
}

.poster-grid {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  opacity: 0.16;
  background:
    linear-gradient(90deg, transparent 49.5%, #fff 50%, transparent 50.5%),
    linear-gradient(transparent 49.5%, #fff 50%, transparent 50.5%);
  background-size: 90rpx 90rpx;
  transform: rotate(-8deg) scale(1.3);
}

.poster-top {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  color: #d9ed72;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.poster-number {
  position: absolute;
  right: -10rpx;
  top: 78rpx;
  color: #f3efe4;
  font-size: 132rpx;
  font-weight: 900;
  letter-spacing: -10rpx;
  line-height: 1;
  opacity: 0.96;
}

.poster-copy {
  position: absolute;
  z-index: 2;
  left: 28rpx;
  bottom: 70rpx;
  max-width: 450rpx;
}

.poster-label {
  color: #d9ed72;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.poster-title {
  margin-top: 15rpx;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.poster-route {
  position: absolute;
  right: 28rpx;
  bottom: 92rpx;
  width: 180rpx;
  height: 120rpx;
  border-right: 3rpx dashed rgba(217, 237, 114, 0.65);
  border-bottom: 3rpx dashed rgba(217, 237, 114, 0.65);
  border-radius: 0 0 80% 0;
}

.route-dot {
  position: absolute;
  right: -12rpx;
  bottom: -12rpx;
  width: 21rpx;
  height: 21rpx;
  border-radius: 50%;
  background: #e55335;
  box-shadow: 0 0 0 10rpx rgba(229, 83, 53, 0.18);
}

.poster-footer {
  position: absolute;
  right: 26rpx;
  bottom: 24rpx;
  left: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
  color: rgba(255, 255, 255, 0.58);
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.poster-arrow {
  color: #d9ed72;
  font-size: 30rpx;
}

.race-card {
  display: flex;
  min-height: 216rpx;
  margin-bottom: 16rpx;
  padding: 22rpx;
  border: 2rpx solid #14221c;
  border-radius: 26rpx;
  background: #fbf8f1;
}

.race-date {
  width: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.race-month {
  color: #6f746d;
  font-size: 19rpx;
  font-weight: 700;
}

.race-day {
  margin: 2rpx 0 8rpx;
  color: #14221c;
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: -3rpx;
  line-height: 1;
}

.race-order {
  color: #e55335;
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.race-divider {
  width: 2rpx;
  margin: 6rpx 22rpx 6rpx 4rpx;
  background: #d5cdc1;
}

.race-main {
  flex: 1;
  min-width: 0;
}

.race-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.race-price {
  color: #e55335;
  font-size: 24rpx;
  font-weight: 900;
}

.race-name {
  margin: 18rpx 0 8rpx;
  color: #14221c;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.35;
}

.race-place {
  overflow: hidden;
  color: #747a73;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.race-foot {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #ded8ce;
  color: #747a73;
  font-size: 19rpx;
}
