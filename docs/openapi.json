{
  "openapi": "3.1.0",
  "info": {
    "title": "Campus Marathon API",
    "version": "0.1.0",
    "description": "校园马拉松赛事、报名、评价、成绩和证书管理接口。"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "本地开发环境"
    }
  ],
  "tags": [
    { "name": "System" },
    { "name": "Authentication" },
    { "name": "User" },
    { "name": "Events" },
    { "name": "Registrations" },
    { "name": "Reviews" },
    { "name": "Certificates" },
    { "name": "Admin" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      },
      "Keyword": {
        "name": "q",
        "in": "query",
        "schema": { "type": "string" }
      },
      "EventId": {
        "name": "eventId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "RegistrationId": {
        "name": "registrationId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "ReviewId": {
        "name": "reviewId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "ResultId": {
        "name": "resultId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "CertificateId": {
        "name": "certificateId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "SchoolId": {
        "name": "schoolId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": {}
            }
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "minLength": 3, "maxLength": 50 },
          "password": { "type": "string", "minLength": 8, "maxLength": 200 }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "username", "role", "nickname"],
        "properties": {
          "id": { "type": "string" },
          "username": { "type": "string" },
          "role": { "type": "string", "enum": ["USER", "ADMIN"] },
          "nickname": { "type": "string" },
          "avatarUrl": { "type": ["string", "null"] },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "location",
          "startsAt",
          "endsAt",
          "registrationOpensAt",
          "registrationClosesAt",
          "feeCents",
          "capacity",
          "status",
          "published"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "location": { "type": "string" },
          "coverUrl": { "type": ["string", "null"] },
          "startsAt": { "type": "string", "format": "date-time" },
          "endsAt": { "type": "string", "format": "date-time" },
          "registrationOpensAt": { "type": "string", "format": "date-time" },
          "registrationClosesAt": { "type": "string", "format": "date-time" },
          "feeCents": { "type": "integer", "minimum": 0 },
          "feeYuan": { "type": "string" },
          "capacity": { "type": "integer", "minimum": 1 },
          "registeredCount": { "type": "integer", "minimum": 0 },
          "remainingSlots": { "type": "integer", "minimum": 0 },
          "published": { "type": "boolean" },
          "status": { "type": "string", "enum": ["UPCOMING", "REGISTERING", "ENDED"] },
          "statusLabel": { "type": "string" },
          "registrationOpen": { "type": "boolean" },
          "registrationClosedReason": { "type": ["string", "null"] }
        }
      },
      "EventInput": {
        "type": "object",
        "required": [
          "title",
          "description",
          "location",
          "startsAt",
          "endsAt",
          "registrationOpensAt",
          "registrationClosesAt",
          "feeCents",
          "capacity"
        ],
        "properties": {
          "title": { "type": "string", "minLength": 2, "maxLength": 120 },
          "description": { "type": "string", "minLength": 5, "maxLength": 3000 },
          "location": { "type": "string", "minLength": 2, "maxLength": 200 },
          "coverUrl": { "type": ["string", "null"] },
          "startsAt": { "type": "string", "format": "date-time" },
          "endsAt": { "type": "string", "format": "date-time" },
          "registrationOpensAt": { "type": "string", "format": "date-time" },
          "registrationClosesAt": { "type": "string", "format": "date-time" },
          "feeCents": { "type": "integer", "minimum": 0 },
          "capacity": { "type": "integer", "minimum": 1 },
          "published": { "type": "boolean" }
        }
      },
      "Registration": {
        "type": "object",
        "required": ["id", "userId", "eventId", "status"],
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "eventId": { "type": "string" },
          "eventTitle": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["WAIT_PAYMENT", "REGISTERED", "COMPLETED", "CANCELLED"]
          },
          "paidAt": { "type": ["string", "null"], "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Review": {
        "type": "object",
        "required": ["id", "eventId", "content", "nickname", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "eventId": { "type": "string" },
          "eventTitle": { "type": "string" },
          "content": { "type": "string" },
          "nickname": { "type": "string" },
          "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "reviewedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "ResultInput": {
        "type": "object",
        "required": ["userId", "eventId", "finishTimeSeconds", "groupName"],
        "properties": {
          "userId": { "type": "string" },
          "eventId": { "type": "string" },
          "finishTimeSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
          "groupName": { "type": "string", "maxLength": 80 },
          "published": { "type": "boolean" }
        }
      },
      "Certificate": {
        "type": "object",
        "required": ["id", "eventId", "eventTitle", "serialNo", "status"],
        "properties": {
          "id": { "type": "string" },
          "eventId": { "type": "string" },
          "eventTitle": { "type": "string" },
          "nickname": { "type": "string" },
          "groupName": { "type": "string" },
          "finishTimeSeconds": { "type": "integer" },
          "serialNo": { "type": "string" },
          "status": { "type": "string", "enum": ["UNISSUED", "ISSUED"] },
          "issuedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "SchoolInput": {
        "type": "object",
        "required": ["name", "code", "contactName", "contactPhone"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 100 },
          "code": { "type": "string", "minLength": 2, "maxLength": 40 },
          "contactName": { "type": "string", "minLength": 2, "maxLength": 40 },
          "contactPhone": { "type": "string", "minLength": 5, "maxLength": 30 }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "请求参数错误",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthorized": {
        "description": "未认证",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Forbidden": {
        "description": "权限不足",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "资源不存在",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Conflict": {
        "description": "业务状态冲突",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["System"],
        "summary": "健康检查",
        "responses": { "200": { "description": "服务正常" } }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "用户登录",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": { "description": "登录成功" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": ["User"],
        "summary": "获取当前用户",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "当前用户" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "patch": {
        "tags": ["User"],
        "summary": "更新当前用户资料",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "更新成功" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/events": {
      "get": {
        "tags": ["Events"],
        "summary": "查询已发布赛事",
        "parameters": [
          { "$ref": "#/components/parameters/Keyword" },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["ALL", "REGISTERING", "UPCOMING", "ENDED"] } },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" }
        ],
        "responses": { "200": { "description": "赛事分页列表" } }
      }
    },
    "/api/events/{eventId}": {
      "get": {
        "tags": ["Events"],
        "summary": "获取赛事详情",
        "parameters": [{ "$ref": "#/components/parameters/EventId" }],
        "responses": {
          "200": { "description": "赛事详情" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/events/{eventId}/registrations": {
      "post": {
        "tags": ["Registrations"],
        "summary": "报名赛事",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/EventId" }],
        "responses": {
          "201": { "description": "报名已创建" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/events/{eventId}/reviews": {
      "get": {
        "tags": ["Reviews"],
        "summary": "获取公开评价",
        "parameters": [{ "$ref": "#/components/parameters/EventId" }],
        "responses": { "200": { "description": "已通过审核的评价" } }
      },
      "post": {
        "tags": ["Reviews"],
        "summary": "提交赛事评价",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/EventId" }],
        "responses": {
          "201": { "description": "评价待审核" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/registrations/{registrationId}/pay": {
      "post": {
        "tags": ["Registrations"],
        "summary": "模拟完成缴费",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/RegistrationId" }],
        "responses": {
          "200": { "description": "缴费成功" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/me/registrations": {
      "get": {
        "tags": ["Registrations"],
        "summary": "获取当前用户报名",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "报名列表" } }
      }
    },
    "/api/me/reviews": {
      "get": {
        "tags": ["Reviews"],
        "summary": "获取当前用户评价",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "评价列表" } }
      }
    },
    "/api/reviews/{reviewId}": {
      "delete": {
        "tags": ["Reviews"],
        "summary": "删除本人评价",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ReviewId" }],
        "responses": {
          "200": { "description": "删除成功" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/me/certificates": {
      "get": {
        "tags": ["Certificates"],
        "summary": "获取当前用户已颁发证书",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "证书列表" } }
      }
    },
    "/api/admin/dashboard": {
      "get": {
        "tags": ["Admin"],
        "summary": "管理员工作台",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "统计与近期赛事" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/admin/events": {
      "get": {
        "tags": ["Admin"],
        "summary": "管理员查询赛事",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Keyword" }],
        "responses": { "200": { "description": "赛事列表" } }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "创建赛事",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EventInput" } } }
        },
        "responses": {
          "201": { "description": "创建成功" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/admin/events/{eventId}": {
      "patch": {
        "tags": ["Admin"],
        "summary": "更新赛事",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/EventId" }],
        "responses": {
          "200": { "description": "更新成功" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Admin"],
        "summary": "删除赛事及关联数据",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/EventId" }],
        "responses": {
          "200": { "description": "删除成功" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/admin/registrations": {
      "get": {
        "tags": ["Admin"],
        "summary": "查询全部报名",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "报名分页列表" } }
      }
    },
    "/api/admin/registrations/{registrationId}": {
      "patch": {
        "tags": ["Admin"],
        "summary": "修改报名状态",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/RegistrationId" }],
        "responses": {
          "200": { "description": "修改成功" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "delete": {
        "tags": ["Admin"],
        "summary": "删除报名",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/RegistrationId" }],
        "responses": { "200": { "description": "删除成功" } }
      }
    },
    "/api/admin/reviews": {
      "get": {
        "tags": ["Admin"],
        "summary": "查询全部评价",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "评价分页列表" } }
      }
    },
    "/api/admin/reviews/{reviewId}": {
      "patch": {
        "tags": ["Admin"],
        "summary": "审核评价",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ReviewId" }],
        "responses": {
          "200": { "description": "审核完成" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "delete": {
        "tags": ["Admin"],
        "summary": "删除评价",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ReviewId" }],
        "responses": { "200": { "description": "删除成功" } }
      }
    },
    "/api/admin/results": {
      "get": {
        "tags": ["Admin"],
        "summary": "查询成绩",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "成绩列表" } }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "录入或更新成绩",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultInput" } } }
        },
        "responses": {
          "201": { "description": "成绩已创建" },
          "200": { "description": "成绩已更新" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/admin/results/{resultId}": {
      "delete": {
        "tags": ["Admin"],
        "summary": "删除成绩",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ResultId" }],
        "responses": { "200": { "description": "删除成功" } }
      }
    },
    "/api/admin/certificates": {
      "get": {
        "tags": ["Admin"],
        "summary": "查询证书",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "证书列表" } }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "为完赛用户生成证书",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "证书已生成" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/admin/certificates/{certificateId}/issue": {
      "patch": {
        "tags": ["Admin"],
        "summary": "颁发证书",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CertificateId" }],
        "responses": {
          "200": { "description": "颁发成功" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/admin/certificates/{certificateId}": {
      "delete": {
        "tags": ["Admin"],
        "summary": "删除证书",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CertificateId" }],
        "responses": { "200": { "description": "删除成功" } }
      }
    },
    "/api/admin/schools": {
      "get": {
        "tags": ["Admin"],
        "summary": "查询合作学校",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "学校列表" } }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "新增合作学校",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SchoolInput" } } }
        },
        "responses": {
          "201": { "description": "创建成功" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/admin/schools/{schoolId}": {
      "delete": {
        "tags": ["Admin"],
        "summary": "删除学校",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/SchoolId" }],
        "responses": { "200": { "description": "删除成功" } }
      }
    }
  }
}
